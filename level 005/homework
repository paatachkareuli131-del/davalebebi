# 9. მომხმარებელს შემოაყვანინეთ სულ პროდუქტების ფასი და ფასდაკლების 
# პროცენტი, გამოთვალეთ ფასდაკლების თანხა და საბოლოო ფასი
#   ფასდაკლება = ფასი x პროცენტი / 100
#   საბოლოო ფასი = საწყისი ფასი - ფასდაკლება

# 1. მონაცემების შემოყვანა
original_price = float(input("შეიყვანეთ პროდუქტების საწყისი ფასი (ლარი): "))
discount_percent = float(input("შეიყვანეთ ფასდაკლების პროცენტი (%): "))

# 2. გამოთვლები მოცემული ფორმულებით
# ფასდაკლება = ფასი x პროცენტი / 100
discount_amount = (original_price * discount_percent) / 100

# საბოლოო ფასი = საწყისი ფასი - ფასდაკლება
final_price = original_price - discount_amount

# 3. შედეგების გამოტანა
print(f"\nფასის დაანგარიშება:")
print(f"ფასდაკლების თანხა: {discount_amount:.2f} ₾")
print(f"საბოლოო გადასახდელი ფასი: {final_price:.2f} ₾")



